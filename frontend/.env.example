# Copy to .env and fill in values from the Supabase dashboard >
# Project Settings > API. These are the public URL + anon key — safe
# to ship to the browser (see lib/supabaseClient.ts for why).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public demo/test login. These values are shipped to the browser,
# so NEVER use a real/private account here. Set VITE_ENABLE_TEST_ACCOUNT=true
# only when you intentionally want the test login button visible.
VITE_ENABLE_TEST_ACCOUNT="false"
VITE_TEST_ACCOUNT_EMAIL="test@example.com"
VITE_TEST_ACCOUNT_PASSWORD="change-this-test-password"

# A second, separate demo/test login — independent credentials from the
# ones above, so this can be a dedicated STUDENT test account distinct
# from the other one. Same rules apply: never a real/private account.
VITE_ENABLE_TEST_STUDENT_ACCOUNT="false"
VITE_TEST_STUDENT_ACCOUNT_EMAIL="test-student@example.com"
VITE_TEST_STUDENT_ACCOUNT_PASSWORD="change-this-test-password-too"

# SECURITY: VITE_* values are embedded into the browser bundle.
# Only use a dedicated throwaway test account here. Never use an admin account
# or any account containing sensitive/private credentials.
