# Copy to .env and fill in real values before running.

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"

# --- Supabase credentials -------------------------------------------
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL="https://your-project-ref.supabase.co"

# The SERVICE ROLE key (not the anon key!) — this bypasses Row Level
# Security, exactly like the old Firebase Admin SDK bypassed
# firestore.rules/storage.rules. Never expose this key to the frontend
# or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket name (Supabase dashboard > Storage > New bucket,
# "Public bucket" OFF). See supabase/schema.sql for the create-bucket
# statement.
SUPABASE_STORAGE_BUCKET="course-files"

# Per-content-type upload limits (megabytes). Enforced server-side on
# every upload — never trust a client-side limit alone.
MAX_VIDEO_SIZE_MB=500
MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Max upload requests per admin per 15-minute window.
UPLOAD_RATE_LIMIT_PER_15MIN=60

# Max total bytes any single user may upload per day (spec #15A),
# across all uploads. Default: 5GB (5368709120).
MAX_USER_UPLOAD_BYTES_PER_DAY=5368709120

# How long a Storage read/delete/list/sign call may take before it's
# treated as a controlled timeout (spec #14). Uploads use the much
# longer UPLOAD_TIMEOUT_MS instead. Default: 30s.
STORAGE_OPERATION_TIMEOUT_MS=30000

# --- Upload resource controls (security hardening pass) --------------
# Hard cap on simultaneous large uploads per instance. Combined with the
# rate limiter above, this bounds how much temp disk / in-flight
# streaming memory a burst of legitimate concurrent uploads can use.
MAX_CONCURRENT_UPLOADS=5

# Hard cap (bytes) on temp storage reserved for uploads currently being
# written/streamed. Default: 2GB (2147483648).
MAX_TEMP_STORAGE_BYTES=2147483648

# How long a single upload request is allowed to stay open before the
# server times it out. Default: 15 minutes.
UPLOAD_TIMEOUT_MS=900000

# Idle-socket timeout applied to every non-upload route. Default: 60s.
DEFAULT_REQUEST_TIMEOUT_MS=60000

# How old (hours) a leftover local /tmp upload file must be before the
# startup/periodic sweep deletes it. Default: 2 hours.
STALE_TEMP_FILE_MAX_AGE_MS=7200000

# How old (hours) an unreferenced Storage object under courses/ must be
# before the daily orphan-cleanup job deletes it. Default: 24 hours.
ORPHAN_FILE_MIN_AGE_HOURS=24

# Node's own HTTP server timeouts (advanced; sane defaults provided).
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEPALIVE_TIMEOUT_MS=61000

# The Google account email allowed to bootstrap itself into ADMIN via
# POST /api/auth/bootstrap-admin (see bootstrap_first_admin in
# supabase/schema.sql). Also used as the default argument for
# scripts/promoteAdmin.js. Does NOT grant admin by itself — see
# ADMIN_BOOTSTRAP_TOKEN below.
SEED_ADMIN_EMAIL="admin@example.com"

# Shared secret required (as the x-bootstrap-token header) to call
# POST /api/auth/bootstrap-admin. Leave unset in normal operation — the
# route returns 404 when this is unset, so bootstrap is off by default.
# To create the seed admin: sign in once as SEED_ADMIN_EMAIL (so a
# STUDENT profile exists), set this to a long random value, deploy,
# call the endpoint once, then UNSET this var and redeploy. The DB
# function also refuses to run a second time once any ADMIN exists, so
# leaving this set after bootstrapping is low-risk but still not
# recommended — least privilege.
ADMIN_BOOTSTRAP_TOKEN=""
