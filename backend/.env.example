# Copy to .env and fill in real values before running.

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"

# Exact browser-visible origins allowed for admin/student image URLs.
# Comma-separated, e.g. https://images.example.com,https://your-project.supabase.co
# Empty means external image URLs are rejected (secure default).
ALLOWED_IMAGE_ORIGINS=""

# Number of trusted reverse-proxy hops. Keep 1 for a single PaaS proxy.
TRUST_PROXY_HOPS=1

# --- Supabase credentials -------------------------------------------
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL="https://your-project-ref.supabase.co"

# The SERVICE ROLE key (not the anon key!) — this bypasses Row Level
# Security, exactly like the old Firebase Admin SDK bypassed
# firestore.rules/storage.rules. Never expose this key to the frontend
# or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket name (Supabase dashboard > Storage > New bucket,
# "Public bucket" OFF). See supabase/schema.sql for the create-bucket
# statement.
SUPABASE_STORAGE_BUCKET="course-files"

# Per-content-type upload limits (megabytes). Enforced server-side on
# every upload — never trust a client-side limit alone.
MAX_VIDEO_SIZE_MB=500
MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

# Max upload requests per admin per 15-minute window.
UPLOAD_RATE_LIMIT_PER_15MIN=60

# Max total bytes any single user may upload per day (spec #15A),
# across all uploads. Default: 5GB (5368709120).
MAX_USER_UPLOAD_BYTES_PER_DAY=5368709120

# How long a Storage read/delete/list/sign call may take before it's
# treated as a controlled timeout (spec #14). Uploads use the much
# longer UPLOAD_TIMEOUT_MS instead. Default: 30s.
STORAGE_OPERATION_TIMEOUT_MS=30000

# --- Upload resource controls (security hardening pass) --------------
# Hard cap on simultaneous large uploads per instance. Combined with the
# rate limiter above, this bounds how much temp disk / in-flight
# streaming memory a burst of legitimate concurrent uploads can use.
MAX_CONCURRENT_UPLOADS=5

# Hard cap (bytes) on temp storage reserved for uploads currently being
# written/streamed. Default: 2GB (2147483648).
MAX_TEMP_STORAGE_BYTES=2147483648

# How long a single upload request is allowed to stay open before the
# server times it out. Default: 15 minutes.
UPLOAD_TIMEOUT_MS=900000

# Idle-socket timeout applied to every non-upload route. Default: 60s.
DEFAULT_REQUEST_TIMEOUT_MS=60000

# How old (hours) a leftover local /tmp upload file must be before the
# startup/periodic sweep deletes it. Default: 2 hours.
STALE_TEMP_FILE_MAX_AGE_MS=7200000

# How old (hours) an unreferenced Storage object under courses/ must be
# before the daily orphan-cleanup job deletes it. Default: 24 hours.
ORPHAN_FILE_MIN_AGE_HOURS=24

# Node's own HTTP server timeouts (advanced; sane defaults provided).
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_KEEPALIVE_TIMEOUT_MS=61000

# The Google account email that is automatically promoted to ADMIN the
# FIRST time it ever logs in — enforced entirely server-side, inside
# the get_or_create_user_profile() Postgres function (see
# supabase/schema.sql), by comparing this value against the
# OAuth-provider-verified email Supabase itself returns for the
# session (never anything the frontend/client sends). Leave unset for
# no auto-promotion. Only affects a brand-new profile's very first
# creation — it will never re-promote or demote an existing account on
# later logins, even if you leave this var set indefinitely. Also used
# as the default argument for scripts/promoteAdmin.js, and as the
# required email match for the separate, token-gated
# POST /api/auth/bootstrap-admin path below (useful for promoting a
# *second* admin without changing this value).
SEED_ADMIN_EMAIL="admin@example.com"

# Shared secret required (as the x-bootstrap-token header) to call
# POST /api/auth/bootstrap-admin — an optional, separate way to promote
# an admin (besides SEED_ADMIN_EMAIL auto-promotion above, and besides
# scripts/promoteAdmin.js), useful e.g. for adding a second admin
# without touching SEED_ADMIN_EMAIL. Leave unset in normal operation —
# the route returns 404 when this is unset, so it's off by default. The
# DB function also refuses to run a second time once any ADMIN exists.
ADMIN_BOOTSTRAP_TOKEN=""

# Secret used to bind protected media playback cookies to this server.
# Generate a random value of at least 32 characters and never expose it to the frontend.
PLAYBACK_TOKEN_SECRET="replace-with-a-random-32-plus-character-secret"
PLAYBACK_TOKEN_TTL_SECONDS=600

# Dedicated test student account. Run `npm run seed:test --workspace backend`
# after setting these values. Keep disabled/empty in production unless you
# intentionally want a public demo account.
TEST_ACCOUNT_EMAIL="test@example.com"
TEST_ACCOUNT_PASSWORD="change-this-test-password"
TEST_ACCOUNT_NAME="Test Student"

# A second, separate dedicated test account, kept independent of the one
# above (different Supabase Auth user, different credentials). Run
# `npm run seed:test:student --workspace backend` after setting these.
# Same STUDENT-only rules apply: keep disabled/empty in production unless
# you intentionally want a public demo account.
TEST_STUDENT_ACCOUNT_EMAIL="test-student@example.com"
TEST_STUDENT_ACCOUNT_PASSWORD="change-this-test-password-too"
TEST_STUDENT_ACCOUNT_NAME="Test Student 2"

# Generate a strong production secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# IMPORTANT: set TEST_ACCOUNT_* only for intentional testing/demo environments.
# Never put a production user's credentials here.

# Self-hosted LiveKit. Keep API secret server-side only.
LIVEKIT_WS_URL=wss://livekit.example.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Live meeting recordings (optional) -------------------------------
# When a live meeting starts, LiveKit Egress can record the room and
# upload the file straight into this project's own private Storage
# bucket over Supabase's S3-compatible endpoint (Supabase dashboard >
# Project Settings > Storage > S3 Connection). Leave any of these unset
# to disable recording entirely — meetings still work fine without it,
# they just won't produce a video for the course afterward.
# See infra/livekit/README.md for the full self-hosted Egress setup
# (docker-compose service + LiveKit webhook config).
MEETING_RECORDINGS_ENABLED=true
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
# Defaults to SUPABASE_STORAGE_BUCKET above if left unset.
SUPABASE_S3_BUCKET=course-files

# Optional: makes the recorded FILE itself use the same spotlight/
# filmstrip layout and speaking-highlight UI as the live meeting,
# instead of LiveKit's generic built-in "grid" template. Point this at
# the deployed frontend's /recording-layout route — it must be a URL
# LiveKit Egress's Chrome instance can actually reach (not "localhost"
# unless Egress runs in the same network namespace as the frontend).
# On the single-server Render deploy (render.yaml) you don't need to
# set this: RENDER_EXTERNAL_URL is provided automatically and already
# points at the one public URL that serves this same frontend build.
# Leave unset to keep using LiveKit's built-in grid layout.
# MEETING_RECORDING_TEMPLATE_URL=https://your-app.example.com/recording-layout
